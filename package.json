{
  "name": "@janiscommerce/api-test",
  "version": "6.1.0",
  "description": "A package for testing APIs developed with @janiscommerce/api",
  "main": "index.js",
  "scripts": {
    "test": "export TEST_ENV=true; mocha --exit -R nyan --recursive tests/",
    "watch-test": "export TEST_ENV=true; mocha --exit -R nyan -w --recursive tests/",
    "coverage": "nyc npm test",
    "lint": "eslint lib/ tests/",
    "build-types": "tsc lib/index.js --declaration --allowJs --emitDeclarationOnly --outDir types --skipLibCheck",
    "prepare": "husky install",
    "coverage-ci": "nyc --reporter=lcov --reporter=text-summary mocha --exit --recursive tests/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janis-commerce/api-test.git"
  },
  "author": "Janis",
  "license": "ISC",
  "homepage": "https://github.com/janis-commerce/api-test.git#readme",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.17.3",
    "husky": "^8.0.1",
    "mocha": "^10.0.0",
    "nyc": "^15.1.0",
    "typescript": "^4.9.5"
  },
  "files": [
    "lib/",
    "types/"
  ],
  "types": "types/index.d.ts",
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "@janiscommerce/api": "^8.0.0",
    "@janiscommerce/api-session": "^3.4.0",
    "sinon": "^15.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
